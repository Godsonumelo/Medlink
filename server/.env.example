# MedLink Backend API

# Port the API listens on (default 3001)
PORT=3001

# Secret used to sign JWTs - CHANGE THIS in production
JWT_SECRET=medlink_dev_secret_change_me

# Allowed frontend origin for CORS (default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Path to the SQLite database file (default server/data/medlink.db)
# DB_PATH=C:\path\to\medlink.db
